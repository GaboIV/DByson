# Copy to .env on the deployment server. Never commit the completed file.
COMPOSE_PROJECT_NAME=dbyson
DBYSON_IMAGE=ghcr.io/gaboiv/dbyson
IMAGE_TAG=0.2.0
BIND_HOST=127.0.0.1
APP_PORT=8082
# No trailing slash. Configure an HTTPS reverse proxy to the port above.
PUBLIC_URL=https://dbyson.example.com
# Reverse-proxy CIDRs/IPs whose X-Forwarded-For/Proto are trusted. Without this,
# audit IPs show the proxy and the per-IP login throttle is shared by everyone.
# Use the address the CONTAINER sees the proxy as: behind Docker's published
# port that is the bridge gateway (often 172.16.0.0/12), not 127.0.0.1. Check an
# audit entry's IP after a login to confirm. Leave empty if exposed directly.
TRUSTED_PROXIES=172.16.0.0/12

# Persistent encryption key: 32 random bytes encoded as base64. Keep a backup.
DBYSON_MASTER_KEY=
# Token required only for the first administrator setup.
DBYSON_SETUP_TOKEN=
# Comma-separated database/SSH hosts or CIDRs. Set to your actual destinations.
DBYSON_ALLOWED_HOSTS=

# --- Google Auth ---
GOOGLE_ENABLED=true
CREDENTIALS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAINS=empresa.com,otraempresa.com
GOOGLE_AUTO_PROVISION=true
GOOGLE_TRUST_MFA=false
